# ─────────────────────────────────────────────────────────────────────────────
# MK Malik — self-hosted live voice rooms
# Copy to .env and adjust. Every value has a working default.
# ─────────────────────────────────────────────────────────────────────────────

# Server -------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
# Public URL, used for share links (leave blank to use request origin)
PUBLIC_URL=

# Security -----------------------------------------------------------------
# Set this to a long random string in production — sessions survive restarts.
# Leave unset and one is generated and stored in data/.jwt-secret
JWT_SECRET=
JWT_TTL=30d

# Comma-separated list, or * to echo the request origin
CORS_ORIGINS=*

# Drop a visitor with no saved session straight into the demo account, so the
# app is immediately usable for evaluation. Defaults to ON outside production.
# Set to 0 for a real public deployment — then new visitors get the sign-in
# screen and POST /api/auth/demo is refused with 403.
DEMO_AUTO_LOGIN=1

# Set to 1 only if you run behind a reverse proxy (nginx, caddy, cloudflare)
TRUST_PROXY=1

# Rooms --------------------------------------------------------------------
MAX_LISTENERS=60
WELCOME_COINS=1500
LOG_REQUESTS=0

# Rate limits (per IP / per account). Raise these when running the test suite
# repeatedly from one machine, or on a private/internal deployment.
AUTH_ATTEMPTS_PER_MIN=12
ROOMS_PER_HOUR=6

# WebRTC -------------------------------------------------------------------
# STUN is enough when peers can reach each other. For mobile networks and
# symmetric NATs you need a TURN relay — otherwise voice connects silently but
# you hear nothing.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Option A: static TURN credentials (any provider — Twilio, Metered, self-hosted)
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=myuser
# TURN_CREDENTIAL=mypassword

# Option B: coturn REST API with a shared secret (credentials auto-expire)
# TURN_URL=turn:turn.example.com:3478
# TURN_SECRET=your-coturn-static-auth-secret

# Storage ------------------------------------------------------------------
# DATA_DIR=./data
# UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=8

# Coin top-ups are disabled unless this token is set; then
# POST /api/wallet/topup { amount, token } credits an account.
# ADMIN_TOPUP_TOKEN=
